{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023", "DOM"],

    "module": "ESNext",

    "types": ["vite/client"],

    "allowArbitraryExtensions": true,

    "skipLibCheck": true,

    "moduleResolution": "bundler",

    "allowImportingTsExtensions": true,

    "verbatimModuleSyntax": true,

    "moduleDetection": "force",

    "noEmit": true,

    "jsx": "react-jsx",

    "ignoreDeprecations": "6.0",

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "strict": true,

    "noUnusedLocals": true,

    "noUnusedParameters": true,

    "erasableSyntaxOnly": true,

    "noFallthroughCasesInSwitch": true
  },

  "include": ["src", "supabase/functions"],
  "exclude": [
    "src/components/report",
    "src/components/ui/AppCard.tsx",
    "src/components/ui/AppDatePicker.tsx",
    "src/components/ui/AppInput.tsx",
    "src/components/ui/AppMultiSelect.tsx",
    "src/components/ui/AppRadioGroup.tsx",
    "src/components/ui/AppSearchDropdown.tsx",
    "src/components/ui/Loading.tsx",
    "src/components/ui/PrimaryButton.tsx",
    "src/components/ui/ScreenHeader.tsx",
    "src/features/attendance/screens",
    "src/features/attendance/hooks/useAttendance.ts",
    "src/features/attendance/services",
    "src/features/attendance/store",
    "src/features/auth/hooks",
    "src/features/auth/screens",
    "src/features/auth/store",
    "src/features/daily-progress",
    "src/features/dealer/components",
    "src/features/dealer/screens",
    "src/features/doctor/components",
    "src/features/doctor/screens",
    "src/features/doctor/hooks/useDoctorPlan.ts",
    "src/features/doctor/hooks/useDoctorVisit.ts",
    "src/features/farmer/screens",
    "src/features/home/screens",
    "src/features/monthlyTourProgramme",
    "src/features/orderDelivery",
    "src/features/profile/screens",
    "src/features/sales/screens",
    "src/features/sales/store",
    "src/features/work",
    "src/navigation/AppNavigator.tsx",
    "src/services/location",
    "src/services/supabase/supabase.ts"
  ]
}
